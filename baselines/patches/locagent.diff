     return tools
 
 
+import re as _re
+
+_LEAKED_PARAM = _re.compile(r'<parameter name="(\w+)">(.*?)(?=\s*(?:</parameter>|<parameter name=|$))', _re.S)
+
+
+def _repair_tool_arguments(arguments):
+    """Repair malformed tool arguments (added for the replication study).
+
+    Some models occasionally (a) send an array argument as a JSON-encoded string, or
+    (b) leak further arguments as `<parameter name="x">value` markup inside a string value.
+    Well-formed arguments are returned unchanged.
+    """
+    if not isinstance(arguments, dict):
+        return arguments
+    fixed = dict(arguments)
+    for key, value in arguments.items():
+        if not isinstance(value, str):
+            continue
+        if '<parameter name=' in value:
+            head, _, _ = value.partition('<parameter name=')
+            for name, val in _LEAKED_PARAM.findall(value):
+                val = val.strip().strip(',').strip()
+                if name not in arguments:
+                    try:
+                        fixed[name] = json.loads(val)
+                    except ValueError:
+                        fixed[name] = val
+            value = head.strip().rstrip(',').strip()
+            fixed[key] = value
+        if value.startswith('[') or value.startswith('{'):
+            value = value.rstrip().rstrip(',').rstrip()
+            try:
+                fixed[key] = json.loads(value)
+            except ValueError:
+                # Further arguments leaked as JSON members: '["x"],\n"direction": "down"'
+                try:
+                    merged = json.loads('{"%s": %s}' % (key, value))
+                except ValueError:
+                    merged = None
+                if isinstance(merged, dict):
+                    fixed[key] = merged[key]
+                    for name, val in merged.items():
+                        if name not in arguments:
+                            fixed[name] = val
+    return fixed
